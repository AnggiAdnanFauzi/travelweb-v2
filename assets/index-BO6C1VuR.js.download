se",category:"Portal & Management",benefit:"Tambah user tambahan",price:"Rp 200.000/user",forPkg:"Productivity+"},{name:"Custom Document Template",category:"Productivity Tools",benefit:"Template dokumen custom",price:"Rp 300.000/template",forPkg:"Productivity+"},{name:"API Integration",category:"Integrasi",benefit:"Integrasi API sederhana",price:"Rp 750.000",forPkg:"Productivity+"},{name:"AI Document Assistant",category:"AI",benefit:"AI untuk draft dokumen",price:"Rp 750.000",forPkg:"Productivity+"},{name:"Dedicated Support",category:"Maintenance",benefit:"Support dedicated",price:"Rp 1.500.000/bulan",forPkg:"Semua Paket"}],annual:{firstYear:["Cloud hosting","Domain (.com/.id)","SSL gratis","5 email bisnis","Backup harian","Monitoring uptime"],subsequent:"Rp 1.000.000–1.200.000/tahun (hosting + domain + SSL)",upgrade:"Cloud hosting premium Rp 2.000.000/tahun, Dedicated server Rp 5.000.000/tahun",thirdParty:"Google Workspace Rp 300.000/tahun/email, Cloud storage Rp 500.000/tahun",ai:"AI assistant API: Rp 200.000–800.000/bulan tergantung penggunaan"},maintenance:[{name:"Maintenance Growth",price:"Rp 900.000/bulan",features:["Update sistem & tools","Backup harian","Update paket & dokumen","Monitoring uptime","Response 1 hari kerja","Maks 10 permintaan/bulan"]},{name:"Dedicated Support",price:"Rp 1.500.000/bulan",features:["Semua Growth","Dedicated support engineer","Priority response 4 jam","Unlimited permintaan wajar","Laporan mingguan"]},{name:"Full Managed",price:"Rp 2.500.000/bulan",features:["Semua Dedicated","Full system management","On-site training (1×/bulan)","Custom development (minor)","SLA 99.9% uptime"]}],faqs:[{q:"Apakah saya bisa memilih template?",a:"Ya. Tersedia template dashboard operasional yang bisa disesuaikan."},{q:"Apakah desain bisa diubah?",a:"Semi-custom dashboard. Bisa penyesuaian warna, logo, dan layout workflow."},{q:"Apakah ada dashboard?",a:"Ya. Operational dashboard untuk manifest, rooming list, quotation, dan database peserta."},{q:"Apakah website bisa dikelola sendiri?",a:"Ya. Admin bisa mengelola paket, dokumen, dan database peserta melalui CMS dashboard. Training disediakan."},{q:"Apakah bisa menambah fitur?",a:"Ya, melalui add-on seperti name tag generator, bus assignment, custom document template."},{q:"Apakah ada biaya tahunan?",a:"Ya, Rp 1.000.000–1.200.000/tahun untuk cloud hosting, domain, dan SSL."},{q:"Apakah domain dan hosting termasuk?",a:"Ya, tahun pertama termasuk cloud hosting dan domain. SSL gratis."},{q:"Apakah bisa memakai domain sendiri?",a:"Tentu. Kami bantu konfigurasi DNS."},{q:"Apakah tersedia maintenance?",a:"Ya, mulai Rp 900.000/bulan dengan dedicated support opsional."},{q:"Apakah bisa upgrade paket?",a:"Ya, bisa upgrade ke Management Platform untuk portal vendor, commission, dan accounting."},{q:"Apakah ada booking real-time?",a:"Tidak. Sistem ini tidak melakukan booking otomatis. Data dimasukkan oleh admin internal."},{q:"Apakah ada pembayaran otomatis?",a:"Tidak ada payment gateway. Sistem ini untuk produktivitas internal, bukan transaksi pelanggan."},{q:"Berapa lama pengerjaan?",a:"Estimasi 25–40 hari kerja setelah materi dan workflow diterima."},{q:"Berapa kali revisi?",a:"4× revisi. Tambahan Rp 250.000/revisi."},{q:"Materi apa yang harus disiapkan?",a:"Logo, daftar paket, workflow operasional, format dokumen existing (manifest, quotation, voucher), dan daftar tim dengan role."}]},{slug:"travel-management-platform",name:"Travel Management Platform",number:6,price:"Mulai Rp24.900.000",priceValue:249e5,slotsLeft:2,slotsTotal:2,color:"#F43F5E",category:"Business Management System",headline:"Platform Internal Lengkap untuk Travel Multi-Divisi",subheadline:"Seluruh website, katalog, growth, productivity, portal vendor/agen, commission engine, dan financial accounting dalam satu platform.",estimate:"1–3 Bulan",support:"90–180 Hari Support",popular:!1,summary:{what:"Travel Management Platform adalah platform internal paling lengkap untuk perusahaan travel yang sudah memili