)}));Lh.displayName=jw.displayName;const xI=[{q:"Apa perbedaan Travel Web dengan web developer biasa?",a:"Travel Web adalah spesialis pembuatan website dan sistem digital khusus untuk industri Tour & Travel. Kami memahami kebutuhan operasional travel seperti itinerary, manifest, rooming list, quotation, dan lainnya. Jadi website yang dibuat bukan sekadar company profile, tapi benar-benar dirancang untuk kebutuhan bisnis travel Anda."},{q:"Apakah Travel Web menyediakan sistem booking online?",a:"Kami tidak menyediakan sistem booking online yang berisiko. Fokus kami adalah membantu bisnis travel mendapatkan leads, membangun kepercayaan, dan mengelola operasional dengan lebih efisien. Untuk proses booking, kami mengarahkan ke WhatsApp atau form inquiry yang lebih aman dan terkontrol."},{q:"Berapa lama waktu pengerjaan website?",a:"Waktu pengerjaan tergantung paket yang dipilih. Landing Page bisa selesai dalam 3-5 hari kerja. Company Profile 7-14 hari. Smart Catalog 14-21 hari. Untuk platform yang lebih kompleks, estimasi akan disampaikan saat konsultasi."},{q:"Apakah saya bisa mengelola website sendiri tanpa coding?",a:"Ya, semua website yang kami bangun menggunakan CMS (Content Management System) yang mudah digunakan. Tim Anda bisa mengupdate konten, menambah paket baru, mengelola galeri foto, dan lainnya tanpa perlu kemampuan coding."},{q:"Apakah ada biaya bulanan atau tahunan?",a:"Biaya yang tercantum adalah biaya pembuatan website (one-time). Biaya hosting dan domain adalah biaya tahunan yang terpisah. Kami juga menawarkan paket maintenance bulanan opsional untuk update rutin dan support teknis."},{q:"Bagaimana proses konsultasi dan pemesanan?",a:"Prosesnya sangat mudah: 1) Hubungi kami via WhatsApp atau form kontak, 2) Konsultasi gratis untuk memahami kebutuhan bisnis Anda, 3) Kami berikan rekomendasi paket dan proposal, 4) Setelah deal, proses pengerjaan dimulai dengan timeline yang jelas."},{q:"Apakah website responsive untuk mobile?",a:"Ya, 100% responsive. Semua website kami dirancang mobile-first sehingga tampilan optimal di semua perangkat — smartphone, tablet, laptop, dan desktop."},{q:"Apakah ada garansi setelah website jadi?",a:"Ya, kami memberikan garansi 30 hari setelah website dilaunching. Selama masa garansi, kami akan memperbaiki bug atau error teknis tanpa biaya tambahan. Setelah garansi, Anda bisa berlangganan paket maintenance bulanan."}];function yI(){const{t:e}=nt();return i.jsx("section",{id:"faq",className:"section-padding",children:i.jsxs("div",{className:"max-w-3xl mx-auto",children:[i.jsxs(z.div,{initial:{opacity:0,y:20},whileInView:{opacity:1,y:0},viewport:{once:!0},className:"text-center mb-12",children:[i.jsx("h2",{className:"font-heading font-extrabold text-3xl md:text-4xl lg:text-5xl tracking-tighter text-foreground mb-4",children:e("faqSection.title")}),i.jsx("p",{className:"text-muted-foreground text-base md:text-lg",children:e("faqSection.subtitle")})]}),i.jsx(Nw,{type:"single",collapsible:!0,className:"space-y-3",children:xI.map((t,a)=>i.jsxs(_h,{value:`faq-${a}`,className:"glass-card rounded-xl px-6 border-none",children:[i.jsx(Fh,{className:"font-heading font-semibold text-sm md:text-base text-foreground hover:no-underline py-5",children:t.q}),i.jsx(Lh,{className:"text-sm text-muted-foreground leading-relaxed pb-5",children:t.a})]},a))})]})})}function Bh(){const{t:e}=nt();return i.jsx("section",{id:"contact",className:"section-padding",children:i.jsx("div",{className:"max-w-4xl mx-auto",children:i.jsxs(z.div,{initial:{opacity:0,y:20},whileInView:{opacity:1,y:0},viewport:{once:!0},className:"relative rounded-3xl overflow-hidden",children:[i.jsx("div",{className:"absolute inset-0 bg-gradient-to-br from-[#050A1F] via-[#0F1B4C] to-[#1A4BFF]"}),i.jsx("div",{className:"absolute inset-0 opacity-20",style:{backgroundImage:"radial-gradient(circle at 30% 40%, rgba(26,75,255,0.3) 0%, transparent 50%), radial-gradient(circle at 70% 60%, rgba(255,107,0,0.2) 0%, transparent 50%)"}}),i.jsxs("div",{classNa