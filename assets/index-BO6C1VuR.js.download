ren:[i.jsx("span",{className:"text-[10px] uppercase tracking-wider font-semibold text-muted-foreground",children:"Fitur Utama"}),i.jsx("div",{className:"flex flex-wrap gap-1 mt-1",children:t.features.map((s,o)=>i.jsx("span",{className:"text-[10px] px-2 py-0.5 rounded-full bg-secondary text-muted-foreground",children:s},o))})]})]})]},a))}),i.jsx("p",{className:"text-center text-xs text-muted-foreground mt-6",children:"Portofolio berdasarkan proyek nyata. Tidak ada klaim hasil angka tanpa data."})]})})}const EI={"landing-page-travel":[{name:"Ahmad Fauzi",company:"Adventure ID",segment:"Open Trip",product:"Travel Landing Page",text:"Dari hanya posting di Instagram, sekarang punya landing page profesional yang fokus. Inquiry open trip langsung meningkat, calon pelanggan bisa lihat semua info dalam satu halaman.",rating:5,result:"50+ inquiry/bulan",avatar:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200"},{name:"Rina Wulandari",company:"Bromo Open Trip",segment:"Open Trip",product:"Travel Landing Page",text:"Landing page yang dibuat benar-benar conversion-oriented. Iklan jadi lebih efektif karena ada landing page khusus. Sticky WhatsApp button sangat membantu.",rating:5,result:"Conversion 3.5%",avatar:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200"},{name:"Hendra Gunawan",company:"Trans Hiace Rental",segment:"Rental Transportasi",product:"Travel Landing Page",text:"Armada dan tarif rental kami sekarang tampil profesional dalam satu halaman. Calon penyewa langsung WhatsApp setelah lihat info kendaraan. Sangat praktis.",rating:5,result:"Booking naik 2x lipat",avatar:"https://images.unsplash.com/photo-1500648766695-9b0a2d2a4e95?w=200"}],"travel-company-profile":[{name:"Lina Maharani",company:"Trans Premium Shuttle",segment:"Rental Transport",product:"Travel Company Profile",text:"Website company profile kami sekarang terlihat premium. Galeri armada, rute, dan legalitas tampil rapi. Brand image naik drastis, calon pelanggan lebih percaya.",rating:5,result:"Booking via web +120%",avatar:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200"},{name:"Bambang Sutrisno",company:"Wisata Nusantara",segment:"Travel Agent",product:"Travel Company Profile",text:"Profil perusahaan, legalitas, dan testimoni pelanggan semua dalam satu website. Google Review widget membuat calon pelanggan langsung percaya dengan layanan kami.",rating:5,result:"Inquiry +80%",avatar:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200"},{name:"Sri Lestari",company:"Desa Wisata Lembang",segment:"Desa Wisata",product:"Travel Company Profile",text:"Potensi desa wisata kami sekarang bisa dilihat calon wisatawan dengan jelas. Aktivitas, homestay, dan produk lokal tampil profesional. Wisatawan meningkat signifikan.",rating:5,result:"Wisatawan +90%",avatar:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200"}],"smart-travel-catalog":[{name:"Reza Pratama",company:"Bali Paradise DMC",segment:"Destination Management",product:"Smart Travel Catalog",text:"Sebagai DMC, kami punya ratusan aktivitas dan paket. Smart Catalog dengan filter destinasi dan budget membuat klien internasional mudah menemukan yang mereka cari. Luar biasa!",rating:5,result:"Klien internasional +200%",avatar:"https://images.unsplash.com/photo-1500648766695-9b0a2d2a4e95?w=200"},{name:"Fatimah Azzahra",company:"Al-Madinah Travel",segment:"Umrah & Haji",product:"Smart Travel Catalog",text:"Katalog paket umrah dengan filter jenis dan bulan keberangkatan sangat membantu jamaah. Itinerary timeline lengkap membuat jamaah lebih percaya. Pendaftaran meningkat 150%.",rating:5,result:"Pendaftaran +150%",avatar:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200"},{name:"Joko Widodo",company:"Konsorsium Travel ID",segment:"Konsorsium",product:"Smart Travel Catalog",text:"Menggabungkan paket dari multiple operator dalam satu katalog terorganisir. Multi-CS WhatsApp memungkinkan inquiry diteruskan ke operator yang tepat. Sangat efisien.",rating:5,result:"Inquiry +160%",avatar:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200"}],"travel-growth-website":[{name:"Budi Santoso",company:"Nusantara Tours",segment:"Tour Operator",product:"Travel Growth Website",text:"Website kami sekarang lebih profesional dan inquiry meningkat 3x lipat. CRM leads membuat tim sales bisa follow-up dengan terstruktur. Meta Pixel dan conversion tracking membuat iklan terukur.",rating:5,result:"Inquiry +300%",avatar:"https://images.unsplash.com/photo-1500648766695-9b0a2d2a4e95?w=200"},{name:"Diana Kusuma",company:"Corporate Travel Solutions",segment:"Corporate Travel",product:"Travel Growth Website",text:"Landing page campaign dengan CRM leads dan conversion tracking sangat membantu tim marketing. Heatmap menunjukkan area yang paling banyak diklik. Marketing jadi data-driven.",rating:5,result:"Conversion 4.8%",avatar:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200"},{name:"Maya Sari",company:"Umrah Plus Travel",segment:"Umrah & Haji",product:"Travel Growth Website",text:"CRM leads dengan status hot/warm/cold membantu tim sales memprioritaskan follow-up. AI deskripsi paket menghemat waktu kami dalam menulis konten. Sangat recommended!",rating:5,result:"Follow-up rate +70%",avatar:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200"}],"travel-productivity-platform":[{name:"Diana Kusuma",company:"Corporate Travel Solutions",segment:"Corporate Travel",product:"Travel Productivity Platform",text:"Manifest generator dan quotation tool sangat membantu operasional tim kami. Yang biasanya butuh berjam-jam di Excel, sekarang hanya hitungan menit. Efisiensi meningkat drastis, error berkurang.",rating:5,result:"Efisiensi +70%, error -85%",avatar:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200"},{name:"Abdul Rahman",company:"Al-Madinah Travel",segment:"Umrah & Haji",product:"Travel Productivity Platform",text:"Database peserta jamaah sekarang terpusat. Rooming list, voucher, dan checklist keberangkatan semua dalam satu platform. Tim operasional jauh lebih cepat dan terorganisir.",rating:5,result:"Dokumen 200+/bulan",avatar:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200"},{name:"Erika Putri",company:"MICE Event Pro",segment:"MICE & Event",product:"Travel Productivity Platform",text:"Run sheet dan checklist keberangkatan sekarang terstandar untuk semua event. Name tag dan voucher dibuat otomatis. Tim event kami jauh lebih produktif dan profesional.",rating:5,result:"Waktu persiapan -60%",avatar:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200"}],"travel-management-platform":[{name:"Hartono Wijaya",company:"Konsorsium Travel ID",segment:"Konsorsium",product:"Travel Management Platform",text:"Portal vendor dan commission engine mengubah cara kami berbisnis. Komisi agen dihitung otomatis, transparent dan akurat. Multi-cabang terintegrasi dengan approval workflow yang jelas.",rating:5,result:"45+ vendor, 120+ agen",avatar:"https://images.unsplash.com/photo-1500648766695-9b0a2d2a4e95?w=200"},{name:"Surya Pranata",company:"Trans Nasional Group",segment:"Multi-cabang",product:"Travel Management Platform",text:"Multi-cabang yang dulu terpisah-pisah sekarang terintegrasi dalam satu platform. Financial accounting internal transparan, profit per paket bisa dilacak dengan jelas. Game changer!",rating:5,result:"8 cabang terintegrasi",avatar:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200"},{name:"Grace Tanudjaja",company:"Global Travel Provider",segment:"Enterprise",product:"Travel Management Platform",text:"Platform enterprise yang mencakup CRM, vendor portal, agent portal, dan financial. Management dashboard memberikan visibility penuh untuk pengambilan keputusan. Investasi yang sangat berharga.",rating:5,result:"ROI dalam 8 bulan",avatar:"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200"}]};function RI(e){return EI[e]||[]}function DI({product:e}){con